{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slooops",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public"
  },
  "routes": [
    { "pattern": "slooops.com", "custom_domain": true },
    { "pattern": "www.slooops.com", "custom_domain": true }
  ]
}
